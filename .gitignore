# Entornos virtuales
env/
venv/
__pycache__/

# Datasets y tensores generados
*.pt
*.pth
*.jpg
*.jpeg
*.png
Bolsas_MIL_Procesadas/
dataset/
data/
images/
CO-MIL/custom_classes.json

# Excepcion: figuras reales de la bitacora/tesis (no son dataset clinico, son
# resultados/diagramas que si deben versionarse)
!documentación/figuras/*.png

# Empaquetado desktop
build/
dist/
*.spec

# Archivos de sistema operativo y VS Code
.vscode/
.DS_Store

# Espacio de trabajo local (contexto, auditorías y scripts de apoyo del proceso,
# no forman parte del código ni la documentación oficial de la tesis)
_proceso_claude/

# Exploraciones/borradores locales dentro del dataset (prefijo "_"): propuestas de
# pre-etiquetado, ayudas de zoom/medición, etc. -- no son anotaciones clínicas
# validadas y no deben subirse hasta pasar por revisión humana explícita.
APP_generador_bolsas/**/_*

# Subproductos de compilación de LaTeX (solo se versiona el .tex y, si se quiere,
# el .pdf final ya compilado)
*.aux
*.log
*.out
*.toc

# Articulo publicado en Springer -- no subir por derechos de autor de la editorial
documentación/Arículo_DFUs_Italia.pdf
